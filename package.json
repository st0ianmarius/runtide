{
  "name": "runtide",
  "version": "0.0.0",
  "private": true,
  "description": "A deterministic TypeScript gameplay framework for abilities, effects, combat, and behavior, independent of rendering and networking.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/st0ianmarius/runtide.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./abilities": "./src/abilities/index.ts",
    "./ai": "./src/ai/index.ts",
    "./area-triggers": "./src/area-triggers/index.ts",
    "./auras": "./src/auras/index.ts",
    "./combat-log": "./src/combat-log/index.ts",
    "./conditions": "./src/conditions/index.ts",
    "./core": "./src/core/index.ts",
    "./cues": "./src/cues/index.ts",
    "./damage": "./src/damage/index.ts",
    "./game": "./src/game/index.ts",
    "./math": "./src/math/index.ts",
    "./modifiers": "./src/modifiers/index.ts",
    "./prediction": "./src/prediction/index.ts",
    "./procs": "./src/procs/index.ts",
    "./replication": "./src/replication/index.ts",
    "./scripts": "./src/scripts/index.ts",
    "./spells": "./src/spells/index.ts",
    "./triggers": "./src/triggers/index.ts",
    "./units": "./src/units/index.ts",
    "./world": "./src/world/index.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test \"tests/**/*.test.ts\"",
    "bench": "node bench/bench.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip"
  },
  "dependencies": {
    "flatbush": "4.6.2",
    "flatqueue": "3.1.0",
    "kdbush": "4.1.0",
    "typedfastbitset": "0.8.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "fast-check": "4.10.2",
    "knip": "6.38.0",
    "mitata": "1.0.34",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
