{
  "name": "runtide",
  "version": "0.0.0",
  "private": true,
  "description": "A deterministic TypeScript gameplay framework for abilities, effects, combat, and behavior, independent of rendering and networking.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/st0ianmarius/runtide.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./abilities": {
      "types": "./dist/abilities/index.d.ts",
      "default": "./dist/abilities/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./area-triggers": {
      "types": "./dist/area-triggers/index.d.ts",
      "default": "./dist/area-triggers/index.js"
    },
    "./auras": {
      "types": "./dist/auras/index.d.ts",
      "default": "./dist/auras/index.js"
    },
    "./combat-log": {
      "types": "./dist/combat-log/index.d.ts",
      "default": "./dist/combat-log/index.js"
    },
    "./conditions": {
      "types": "./dist/conditions/index.d.ts",
      "default": "./dist/conditions/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./cues": {
      "types": "./dist/cues/index.d.ts",
      "default": "./dist/cues/index.js"
    },
    "./damage": {
      "types": "./dist/damage/index.d.ts",
      "default": "./dist/damage/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "default": "./dist/math/index.js"
    },
    "./modifiers": {
      "types": "./dist/modifiers/index.d.ts",
      "default": "./dist/modifiers/index.js"
    },
    "./prediction": {
      "types": "./dist/prediction/index.d.ts",
      "default": "./dist/prediction/index.js"
    },
    "./procs": {
      "types": "./dist/procs/index.d.ts",
      "default": "./dist/procs/index.js"
    },
    "./replication": {
      "types": "./dist/replication/index.d.ts",
      "default": "./dist/replication/index.js"
    },
    "./scripts": {
      "types": "./dist/scripts/index.d.ts",
      "default": "./dist/scripts/index.js"
    },
    "./spells": {
      "types": "./dist/spells/index.d.ts",
      "default": "./dist/spells/index.js"
    },
    "./triggers": {
      "types": "./dist/triggers/index.d.ts",
      "default": "./dist/triggers/index.js"
    },
    "./units": {
      "types": "./dist/units/index.d.ts",
      "default": "./dist/units/index.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "default": "./dist/world/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "del-cli dist && tsc -p tsconfig.build.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "bench": "node bench/bench.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip"
  },
  "dependencies": {
    "flatbush": "4.6.2",
    "flatqueue": "3.1.0",
    "kdbush": "4.1.0",
    "typedfastbitset": "0.8.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "del-cli": "7.0.0",
    "fast-check": "4.10.2",
    "knip": "6.38.0",
    "mitata": "1.0.34",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
